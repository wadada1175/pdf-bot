# .env にコピーして値を埋める（.env は Git などで共有しない）

# Discord Developer Portal の Bot トークン
DISCORD_TOKEN=
# 研究室の Discord サーバー ID
GUILD_ID=
# 印刷を許可するロール ID（空ならサーバーの全メンバー）
ALLOWED_ROLE_ID=
# /print を使えるチャンネル ID（空ならどこでも）
PRINT_CHANNEL_ID=

# ターミナルで `lpstat -p` を実行して表示されるプリンター名
PRINTER_NAME=EPSON_LP_S440DN

# 研究室 LAN のアドレス範囲（カンマ区切り）。ここに入る端末からだけ確認ページを開ける
LAN_CIDRS=192.168.1.0/24
# 確認リンクの先頭。Bot を動かす Mac mini の LAN 内 IP とポート
PUBLIC_BASE_URL=http://192.168.1.50:8080
WEB_HOST=0.0.0.0
WEB_PORT=8080

MAX_FILE_MB=20
MAX_PAGES=50
MAX_COPIES=5
DAILY_PAGE_LIMIT=100
MAX_PENDING_PER_USER=3
TOKEN_TTL_MIN=10
